{
  "name": "obsidian-crm",
  "version": "0.2.0",
  "description": "A local-first CRM for solo professionals inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "crm",
    "local-first"
  ],
  "author": "Leandro Garcia",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.11.30",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.71.1"
  }
}
