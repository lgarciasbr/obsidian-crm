{
  "name": "obsidian-crm",
  "version": "0.3.0",
  "description": "A local-first CRM for solo professionals inside Obsidian.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgarciasbr/obsidian-crm.git"
  },
  "bugs": {
    "url": "https://github.com/lgarciasbr/obsidian-crm/issues"
  },
  "homepage": "https://github.com/lgarciasbr/obsidian-crm#readme",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "crm",
    "local-first"
  ],
  "author": "Leandro Garcia",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.71.1"
  }
}
