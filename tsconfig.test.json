{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-test",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "src/crm/integrity.ts",
    "src/crm/validator.ts",
    "src/crm/markdown-sections.ts",
    "src/crm/frontmatter.ts",
    "tests/**/*.ts"
  ]
}
